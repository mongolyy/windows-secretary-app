{
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    "module": "ESNext",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["node"],
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "forceConsistentCasingInFileNames": true,
    "paths": {
      "electrobun": ["./src/lib/electrobun-main-stub.ts"],
      "electrobun/main": ["./src/lib/electrobun-main-stub.ts"],
      "electrobun/view": ["./src/lib/electrobun-view-stub.ts"]
    }
  },
  "include": ["src"],
  "exclude": ["src/bun"]
}
