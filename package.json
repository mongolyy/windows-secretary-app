{
  "name": "secretary",
  "private": true,
  "version": "0.1.0",
  "description": "Notionから書き出したCSVを手元で読む、常時表示の予定ウィンドウ",
  "type": "module",
  "packageManager": "bun@1.4.4",
  "scripts": {
    "dev": "vite",
    "build:web": "vite build",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.bun.json",
    "lint": "eslint .",
    "format:check": "prettier --check .",
    "desktop:dev": "bun scripts/dev-desktop.mjs",
    "desktop:build": "bun scripts/build-desktop.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/bun": "1.3.13",
    "@types/node": "^22.19.1",
    "@vitest/coverage-v8": "^5.1.1",
    "electrobun": "2.0.6",
    "eslint": "^10.15.0",
    "prettier": "^3.10.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.73.0",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  }
}
